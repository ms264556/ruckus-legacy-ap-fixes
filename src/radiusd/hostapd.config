# hostapd build configuration for rmc-radiusd: hostapd's integrated RADIUS server and EAP server only, no
# wireless driver, no control interface. The AP's own hostapd sends its Access-Requests to it on 127.0.0.2.
CONFIG_DRIVER_NONE=y
CONFIG_RADIUS_SERVER=y
CONFIG_IPV6=y

CONFIG_EAP=y
CONFIG_EAP_MSCHAPV2=y
CONFIG_EAP_PEAP=y
CONFIG_EAP_TTLS=y
CONFIG_EAP_TLS=y

CONFIG_TLS=wolfssl
CONFIG_TLSV11=y
CONFIG_TLSV12=y

CONFIG_NO_CTRL_IFACE=y
CONFIG_NO_VLAN=y
CONFIG_NO_ACCOUNTING=y
CONFIG_NO_DUMP_STATE=y
CONFIG_DEBUG_SYSLOG=y
